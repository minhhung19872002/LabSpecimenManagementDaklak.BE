# Build Stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy only necessary project files (avoid copying test projects to save memory)
COPY src/ ./src/
COPY *.sln ./
COPY *.props ./

# Restore dependencies for the DbMigrator project with limited parallelism
RUN dotnet restore src/LabSpecimenManagement.DbMigrator/LabSpecimenManagement.DbMigrator.csproj \
    --runtime linux-x64

# Build and publish the DbMigrator project with memory optimization
WORKDIR /src/src/LabSpecimenManagement.DbMigrator
RUN dotnet publish -c Release -o /app/publish \
    --no-restore \
    --runtime linux-x64 \
    --self-contained false \
    /p:PublishTrimmed=false \
    /p:PublishSingleFile=false \
    /maxcpucount:1

# Runtime Stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

# Install PostgreSQL client for database readiness check
RUN apt-get update && apt-get install -y postgresql-client && rm -rf /var/lib/apt/lists/*

# Copy published application from build stage
COPY --from=build /app/publish .

# Create entrypoint script with retry logic
RUN echo '#!/bin/sh\n\
echo "Waiting for database to be ready..."\n\
max_retries=30\n\
retry_count=0\n\
\n\
while [ $retry_count -lt $max_retries ]; do\n\
  if pg_isready -h postgres -p 5432 -U postgres > /dev/null 2>&1; then\n\
    echo "Database is ready!"\n\
    break\n\
  fi\n\
  echo "Waiting for database... ($retry_count/$max_retries)"\n\
  sleep 2\n\
  retry_count=$((retry_count + 1))\n\
done\n\
\n\
if [ $retry_count -eq $max_retries ]; then\n\
  echo "Database connection timeout!"\n\
  exit 1\n\
fi\n\
\n\
echo "Starting database migration..."\n\
dotnet LabSpecimenManagement.DbMigrator.dll\n\
exit_code=$?\n\
\n\
if [ $exit_code -eq 0 ]; then\n\
  echo "Migration completed successfully!"\n\
else\n\
  echo "Migration failed with exit code: $exit_code"\n\
fi\n\
\n\
exit $exit_code' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Production

# Run the migrator (it will exit after completion)
ENTRYPOINT ["/app/entrypoint.sh"]
