# Build Stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy ALL project files first (this allows Docker to cache dependencies)
COPY src/ ./src/
COPY test/ ./test/
COPY *.sln ./
COPY *.props ./

# Restore dependencies for the DbMigrator project
RUN dotnet restore src/LabSpecimenManagement.DbMigrator/LabSpecimenManagement.DbMigrator.csproj

# Build and publish the DbMigrator project
WORKDIR /src/src/LabSpecimenManagement.DbMigrator
RUN dotnet publish -c Release -o /app/publish --no-restore

# Runtime Stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

# Copy published application from build stage
COPY --from=build /app/publish .

# Set environment variables for better error handling
ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    LC_ALL=en_US.UTF-8 \
    LANG=en_US.UTF-8

# Create a simple entrypoint script
RUN printf '#!/bin/bash\n\
set -e\n\
\n\
echo "=== Database Migration Started ==="\n\
echo "Waiting 10 seconds for database to be fully ready..."\n\
sleep 10\n\
\n\
echo "Running migrations..."\n\
dotnet LabSpecimenManagement.DbMigrator.dll 2>&1 | tee /tmp/migration.log\n\
\n\
if [ ${PIPESTATUS[0]} -eq 0 ]; then\n\
  echo "=== Migration Completed Successfully ==="\n\
  exit 0\n\
else\n\
  echo "=== Migration Failed ==="\n\
  cat /tmp/migration.log\n\
  exit 1\n\
fi\n' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Run the migrator
ENTRYPOINT ["/app/entrypoint.sh"]
