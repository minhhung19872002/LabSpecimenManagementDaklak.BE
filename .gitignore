## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# Local NuGet Cache (custom for this project)
.nuget-packages/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Mac
.DS_Store

# Docker volumes
docker-volumes/

# Environment files
*.env
*.env.local
*.env.*.local

# Logs
logs/
*.log

# Certificate files (except example)
*.pfx
*.p12
!openiddict.pfx

# Database
*.db
*.db-shm
*.db-wal

# Backup files
*.bak
*~

# ABP Suite
.suite/

# Swagger
swagger.json
